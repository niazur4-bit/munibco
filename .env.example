# Copy this file to .env and fill in real values before running.

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True

# --- Database ---
# Leave USE_POSTGRES=False to use local SQLite (default, no setup needed).
# Set USE_POSTGRES=True and fill the PG* values with your Neon connection details to use Postgres.
USE_POSTGRES=False
PGDATABASE=
PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=5432

# --- Media storage ---
# Leave USE_CLOUDINARY=False to store uploads on local disk (fine for local dev).
# Set USE_CLOUDINARY=True and fill these in for production (Vercel's filesystem is ephemeral).
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (for password reset links) ---
# Leave as console backend to print reset links to the terminal during development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# To send real emails via Gmail SMTP, switch to:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Munib and Co <noreply@munibandco.com>

# --- Deployment ---
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
